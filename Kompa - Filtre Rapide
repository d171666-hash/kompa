// ==UserScript==
// @name         Kompa -3.0.0 Filtre Rapide Statuts Devis
// @namespace    http://tampermonkey.net/
// @version      3.0.0
// @description  Filtre rapide pour les devis en cours sans ralentissement
// @match        https://app.kompa.pro/quotes*
// @updateURL    https://raw.githubusercontent.com/d171666-hash/kompa/refs/heads/main/Kompa%20-%20Filtre%20Rapide
// @downloadURL  https://raw.githubusercontent.com/d171666-hash/kompa/refs/heads/main/Kompa%20-%20Filtre%20Rapide
// @grant        none
// ==/UserScript==

(function() {
    'use strict';

    const TARGET_STATUSES = ['Brouillon', 'Finalisé', 'Signé', 'À relancer', 'Relancé'];

    function triggerNativeClick(element) {
        const eventOptions = { bubbles: true, cancelable: true, view: window };
        element.dispatchEvent(new MouseEvent('mousedown', eventOptions));
        element.dispatchEvent(new MouseEvent('mouseup', eventOptions));
        element.dispatchEvent(new MouseEvent('click', eventOptions));
    }

    function setupQuickFilter() {
        const searchInput = document.querySelector('input[placeholder*="Rechercher statuts"]');
        if (!searchInput) return;

        // Éviter les injections multiples
        const popover = searchInput.closest('div[class*="popover"], div[class*="dropdown"]') || searchInput.parentElement.parentElement;
        if (!popover || popover.querySelector('.kompa-quick-container')) return;

        // Conteneur sous la barre de recherche du menu
        const container = document.createElement('div');
        container.className = 'kompa-quick-container';
        container.style.cssText = `
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 6px 10px;
            margin: 6px 0;
            background-color: #f0f9ff;
            border: 1px solid #bae6fd;
            border-radius: 4px;
            cursor: pointer;
            font-size: 11px;
            font-weight: 600;
            color: #0284c7;
            user-select: none;
        `;

        const checkbox = document.createElement('input');
        checkbox.type = 'checkbox';
        checkbox.style.cssText = 'cursor: pointer; accent-color: #0284c7; width: 14px; height: 14px; margin: 0;';

        const label = document.createElement('span');
        label.innerText = '⚡ Sélectionner devis "En cours"';

        container.appendChild(checkbox);
        container.appendChild(label);

        searchInput.parentElement.after(container);

        // Action lors du clic
        container.onclick = (e) => {
            e.preventDefault();
            e.stopPropagation();

            const targetState = !checkbox.checked;
            checkbox.checked = targetState;

            // Recherche des options de statut
            const options = Array.from(popover.querySelectorAll('label, div')).filter(el => {
                const txt = el.innerText ? el.innerText.trim() : '';
                return TARGET_STATUSES.includes(txt);
            });

            options.forEach(opt => {
                const input = opt.querySelector('input[type="checkbox"]');
                if (input && input.checked !== targetState) {
                    triggerNativeClick(input);
                }
            });
        };
    }

    // Écouteur ciblé sur les clics utilisateur (évite le ralentissement)
    document.addEventListener('click', (e) => {
        const btnStatuts = e.target.closest('button, div');
        if (btnStatuts && btnStatuts.innerText && btnStatuts.innerText.includes('Statuts')) {
            setTimeout(setupQuickFilter, 100);
        }
    }, true);

})();
