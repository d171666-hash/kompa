// ==UserScript== 
// @name         Kompa - Filtre 3.2.0 Rapide Statuts Devis
// @namespace    http://tampermonkey.net/
// @version      3.2.0
// @description  Bouton d'action rapide pour cocher les devis en cours avec délai
// @match        https://app.kompa.pro/quotes*
// @updateURL    https://raw.githubusercontent.com/d171666-hash/kompa/refs/heads/main/Kompa%20-%20Filtre%20Rapide.user.js
// @downloadURL  https://raw.githubusercontent.com/d171666-hash/kompa/refs/heads/main/Kompa%20-%20Filtre%20Rapide.user.js
// @grant        none
// ==/UserScript==

(function() {
    'use strict';

    const TARGET_STATUSES = ['Brouillon', 'Finalisé', 'Signé', 'À relancer', 'Relancé'];

    function forceClick(element) {
        if (!element) return;
        ['mousedown', 'mouseup', 'click'].forEach(eventType => {
            element.dispatchEvent(new MouseEvent(eventType, {
                bubbles: true,
                cancelable: true,
                view: window
            }));
        });
    }

    function injectActionButtons() {
        const searchInput = document.querySelector('input[placeholder*="Rechercher statuts"]');
        if (!searchInput) return;

        const containerParent = searchInput.parentElement;
        if (!containerParent || containerParent.querySelector('.kompa-action-wrapper')) return;

        const wrapper = document.createElement('div');
        wrapper.className = 'kompa-action-wrapper';
        wrapper.style.cssText = `
            display: flex;
            gap: 6px;
            margin: 6px 0;
            width: 100%;
            box-sizing: border-box;
        `;

        const btnSelect = document.createElement('button');
        btnSelect.type = 'button';
        btnSelect.innerText = '⚡ Cocher "En cours"';
        btnSelect.style.cssText = `
            flex: 1;
            padding: 5px 8px;
            background: #0284c7;
            color: #ffffff;
            border: none;
            border-radius: 4px;
            font-size: 11px;
            font-weight: bold;
            cursor: pointer;
        `;

        wrapper.appendChild(btnSelect);
        containerParent.after(wrapper);

        // Clics séquentiels espacés dans le temps
        btnSelect.onclick = async (e) => {
            e.preventDefault();
            e.stopPropagation();

            btnSelect.innerText = '⏳ Sélection en cours...';
            btnSelect.disabled = true;

            for (const statusName of TARGET_STATUSES) {
                const dropdown = searchInput.closest('div[class*="popover"], div[class*="dropdown"]') || document.body;
                const labels = Array.from(dropdown.querySelectorAll('label, div'));

                const targetNode = labels.find(node => {
                    const txt = node.innerText ? node.innerText.trim() : '';
                    return txt === statusName;
                });

                if (targetNode) {
                    const input = targetNode.querySelector('input[type="checkbox"]');
                    if (input && !input.checked) {
                        forceClick(input);
                    } else if (!input) {
                        forceClick(targetNode);
                    }
                    // Pause de 120ms pour laisser React enregistrer le clic
                    await new Promise(resolve => setTimeout(resolve, 120));
                }
            }

            btnSelect.innerText = '⚡ Cocher "En cours"';
            btnSelect.disabled = false;
        };
    }

    document.addEventListener('click', (e) => {
        const target = e.target;
        if (target && target.innerText && target.innerText.includes('Statuts')) {
            setTimeout(injectActionButtons, 150);
        }
    }, true);

})();
