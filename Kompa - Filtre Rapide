// ==UserScript==
// @name         Kompa - Filtre Rapide Statuts Devis
// @namespace    http://tampermonkey.net/
// @version      2.1.0
// @description  Ajoute une option rapide "En cours" dans le filtre Statuts avec support des mises à jour auto
// @match        https://app.kompa.pro/quotes*
// @updateURL    https://raw.githubusercontent.com/d171666-hash/kompa/main/KompaStatuts.user.js
// @downloadURL  https://raw.githubusercontent.com/d171666-hash/kompa/main/KompaStatuts.user.js
// @grant        none
// ==/UserScript==

(function() {
    'use strict';

    const TARGET_STATUSES = ['Brouillon', 'Finalisé', 'Signé', 'À relancer', 'Relancé'];

    function injectCustomOption() {
        const searchInput = document.querySelector('input[placeholder*="Rechercher statuts"]');
        if (!searchInput) return;

        // Éviter les doublons
        const parentContainer = searchInput.parentElement;
        if (!parentContainer || parentContainer.querySelector('.kompa-quick-container')) return;

        // Conteneur propre sous le champ de recherche
        const container = document.createElement('div');
        container.className = 'kompa-quick-container';
        container.style.cssText = `
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 6px 10px;
            margin: 6px 0;
            background-color: #f0f9ff;
            border: 1px solid #bae6fd;
            border-radius: 4px;
            cursor: pointer;
            font-size: 11px;
            font-weight: 600;
            color: #0284c7;
            user-select: none;
            width: 100%;
            box-sizing: border-box;
        `;

        const checkbox = document.createElement('input');
        checkbox.type = 'checkbox';
        checkbox.className = 'kompa-quick-chk';
        checkbox.style.cssText = 'cursor: pointer; accent-color: #0284c7; width: 14px; height: 14px; margin: 0;';

        const label = document.createElement('span');
        label.innerText = '⚡ Sélectionner devis "En cours"';

        container.appendChild(checkbox);
        container.appendChild(label);

        // Insertion après la barre de recherche
        parentContainer.after(container);

        // Détection de l'état actuel des cases natives
        const updateMasterState = () => {
            const popup = searchInput.closest('div[class*="popover"], div[class*="dropdown"], div[style*="z-index"]') || document.body;
            const labels = Array.from(popup.querySelectorAll('label, div'));
            
            let matchCount = 0;
            let checkedCount = 0;

            labels.forEach(el => {
                const text = el.innerText ? el.innerText.trim() : '';
                if (TARGET_STATUSES.includes(text)) {
                    matchCount++;
                    const input = el.querySelector('input[type="checkbox"]');
                    if (input && input.checked) checkedCount++;
                }
            });

            checkbox.checked = matchCount > 0 && checkedCount === matchCount;
        };

        // Action au clic
        const toggleAll = (e) => {
            e.preventDefault();
            e.stopPropagation();

            const targetState = !checkbox.checked;
            checkbox.checked = targetState;

            const popup = searchInput.closest('div[class*="popover"], div[class*="dropdown"], div[style*="z-index"]') || document.body;
            const labels = Array.from(popup.querySelectorAll('label, div'));

            labels.forEach(el => {
                const text = el.innerText ? el.innerText.trim() : '';
                if (TARGET_STATUSES.includes(text)) {
                    const input = el.querySelector('input[type="checkbox"]');
                    if (input && input.checked !== targetState) {
                        input.click();
                    }
                }
            });
        };

        container.onclick = toggleAll;
        checkbox.onclick = (e) => e.stopPropagation();

        updateMasterState();
    }

    const observer = new MutationObserver(() => {
        injectCustomOption();
    });

    observer.observe(document.body, { childList: true, subtree: true });
})();
